/**
 * Practice #4: Realtime Chat Room (Alarms + WebSockets)
 * 설정은 introduction-to-durable-objects와 같은 패턴이다.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "realtime-chat",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-25",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,

	/**
	 * ★ DO 바인딩: 방 하나 = ChatRoom 인스턴스 하나.
	 * class_name은 src에서 export한 클래스 이름과 정확히 일치해야 한다.
	 * 워커 코드에서는 env.CHAT으로 부른다. 수정했으면 `npm run cf-typegen`.
	 */
	"durable_objects": {
		"bindings": [
			{
				"class_name": "ChatRoom",
				"name": "CHAT"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["ChatRoom"]
		}
	]
}
