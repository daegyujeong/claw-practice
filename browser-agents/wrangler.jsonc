/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "browser-agents",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-15",
  "assets": {
    "not_found_handling": "single-page-application",
  },
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  "compatibility_flags": ["nodejs_compat"],
  // Section 4와 같은 AI 바인딩 — 모델(glm-4.7-flash)을 부르는 데 쓴다.
  "ai": {
    "binding": "AI",
  },
  // AIChatAgent도 결국 Durable Object라서 DO 바인딩 + SQLite 마이그레이션이 필요하다.
  "durable_objects": {
    "bindings": [
      {
        "class_name": "BrowserAgent",
        "name": "BrowserAgent",
      },
    ],
  },
  "migrations": [
    {
      "new_sqlite_classes": ["BrowserAgent"],
      "tag": "1",
    },
  ],
  // 7.0 — 새 바인딩 ①: Browser Rendering. Cloudflare 서버에서 실제 Chrome을 띄워
  //   주는 서비스이고, 워커는 env.BROWSER로 그 브라우저에 접속한다(연결만 받는다).
  //   Env 타입에서는 `BROWSER: BrowserRun` — 7.3의 createBrowserTools와
  //   7.4의 puppeteer.launch 둘 다 이 바인딩을 받는다.
  "browser": {
    "binding": "BROWSER",
  },
  // 7.0 — 새 바인딩 ②: Worker Loaders = "동적 워커"를 만드는 바인딩.
  //   런타임에 임의의 코드로 새 워커를 띄울 수 있다. 7.3에서 모델이 써 낸
  //   브라우저 조작 코드를 우리 워커(this.env가 있는 곳)가 아니라 env·네트워크가
  //   없는 격리 워커에서 실행하기 위해 쓴다. 왜 필요한지는 notes/section-07 참고.
  //   `browser`/`ai`와 달리 배열 형태다 — 이름이 다른 로더를 여러 개 둘 수 있다.
  "worker_loaders": [{ "binding": "LOADER" }],
  // 바인딩을 추가/변경한 뒤에는 반드시 `npm run cf-typegen`(= wrangler types)으로
  //   worker-configuration.d.ts를 다시 만들어야 this.env.BROWSER 타입이 생긴다.
}
